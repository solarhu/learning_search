# 后端服务配置示例
# 复制此文件为 .env 并填入你的配置

# ============== 必填配置 ==============

# OpenAI API Key（必需）
OPENAI_API_KEY=your-openai-api-key-here

# ============== 可选配置 ==============

# OpenAI API Base URL（默认为 OpenAI 官方地址）
# 如使用其他兼容接口（如 Azure OpenAI、本地部署等），修改此地址
# OPENAI_API_BASE=https://api.openai.com/v1

# 使用的模型名称（默认 gpt-4o）
# OPENAI_MODEL=gpt-4o

# 服务端口（默认 8081）
# PORT=8081